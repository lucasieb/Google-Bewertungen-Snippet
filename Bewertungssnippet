<section id="mm-reviews" aria-label="Kundenbewertungen" style="box-sizing:border-box;">
  <style>
    :root{
      --ink:#202124; --muted:#5f6368; --card:#ffffff; --ghost:#f1f3f4;
      --accent:#1a73e8; --shadow:0 8px 24px rgba(60,64,67,.12);
      --radius:14px; --maxw:1100px; --arrow-offset:clamp(40px,6.6vw,64px);
    }

    /* wirklich transparent */
    #mm-reviews{
      width:100%;
      padding:clamp(16px,3vw,32px) 10px;
      display:flex; align-items:center; justify-content:center; flex-direction:column;
      background:transparent !important;
      font-family:Poppins,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      color:var(--ink); -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    }
    #mm-reviews *,#mm-reviews *::before,#mm-reviews *::after{ box-sizing:border-box; }
    .mm-wrap{ width:100%; max-width:var(--maxw); }

    /* ===== Carousel ===== */
    .mm-carousel{
      position:relative; width:100%;
      height:340px; /* wird per JS auf max Kartenhöhe gesetzt */
      margin:6px 0 8px 0; padding:0 var(--arrow-offset); background:transparent;
      display:flex; align-items:center; justify-content:center;
      overflow:visible;
    }
    .mm-track{ position:relative; width:100%; height:100%; }

    .mm-card{
      position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
      width:min(500px,88%);
      background:var(--card);
      border-radius:var(--radius);
      padding:18px;
      box-shadow:var(--shadow);
      transition:transform .45s cubic-bezier(.2,.9,.2,1), opacity .35s ease, filter .35s ease;
      backface-visibility:hidden; overflow:hidden;
    }
    .mm-card .head{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:10px; }
    .mm-card .source{ display:inline-flex; align-items:center; gap:6px; font-weight:600; font-size:13.5px; color:var(--muted); letter-spacing:.3px; text-transform:none; }
    .mm-card .source svg{ width:18px; height:18px; display:block; }
    .mm-card .source span{ display:block; }
    .mm-card .head .stars{ margin:0 0 0 auto; }
    .mm-card .stars{ font-size:17px; color:#f6b042; letter-spacing:.4px; }
    .mm-card .quote{ font-size:15.5px; line-height:1.55; margin-bottom:10px; position:relative; }
    .mm-card .meta{
      display:flex; align-items:center; justify-content:space-between; gap:10px;
      color:var(--muted); font-size:13.5px;
      border-top:1px solid rgba(60,64,67,.08); padding-top:9px; margin-top:6px;
    }
    .mm-card .meta .who{ font-weight:600; color:var(--ink); }
    .mm-card .meta .type{ color:var(--muted); text-align:right; }

    .mm-card .more-toggle{
      display:none; margin:0 0 10px; padding:0; border:none; background:none;
      color:var(--accent); font-weight:600; font-size:14px; cursor:pointer;
      align-items:center; gap:6px;
    }
    .mm-card .more-toggle:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:6px; }
    .mm-card .more-toggle svg{ width:16px; height:16px; transition:transform .2s ease; }
    .mm-card.is-expanded .more-toggle svg{ transform:rotate(180deg); }

    /* Zustände (Desktop) */
    .is-active{ transform:translate(-50%,-50%) translateZ(70px) scale(1); opacity:1; z-index:40; filter:none; background:#fff; }
    .is-prev  { transform:translate(-50%,-50%) translateX(-68%) translateZ(-120px) scale(.68); opacity:.36; z-index:20; filter:grayscale(.2) brightness(.92); background:var(--ghost); }
    .is-next  { transform:translate(-50%,-50%) translateX(68%)  translateZ(-120px) scale(.68); opacity:.36; z-index:20; filter:grayscale(.2) brightness(.92); background:var(--ghost); }
    .is-hide  { opacity:0; pointer-events:none; z-index:10; }

    /* Pfeile */
    .mm-arrow{
      position:absolute; top:50%; transform:translateY(-50%);
      width:40px; height:40px; border-radius:50%;
      display:grid; place-items:center;
      background:#fff; border:1px solid rgba(0,0,0,.1);
      box-shadow:0 4px 16px rgba(0,0,0,.08);
      color:var(--ink); cursor:pointer;
      transition:transform .12s ease, background .2s ease; z-index:50;
    }
    .mm-arrow:hover{ transform:translateY(-50%) scale(1.04); background:#fafafa; }
    .mm-arrow:active{ transform:translateY(-50%) scale(.98); }
    .mm-arrow.left{ left:calc(var(--arrow-offset) * -0.42); }
    .mm-arrow.right{ right:calc(var(--arrow-offset) * -0.42); }
    .mm-arrow svg{ width:22px; height:22px; display:block; }

    /* ===== Google-Profil fix ===== */
    .mm-gprof{
      margin:10px auto 0; width:100%; max-width:var(--maxw);
      display:flex; align-items:center; justify-content:space-between; gap:16px;
      padding:14px 18px; border:1px solid rgba(60,64,67,.08); border-radius:999px;
      background:#fff; box-shadow:0 6px 18px rgba(60,64,67,.06);
      cursor:default; opacity:.6; transition:opacity .2s ease, box-shadow .2s ease, transform .2s ease;
    }
    .mm-gprof.enabled{ opacity:1; box-shadow:0 10px 28px rgba(60,64,67,.12); cursor:pointer; }
    .mm-gprof.enabled:focus-visible{ outline:2px solid var(--accent); outline-offset:4px; }
    .mm-gprof.enabled:hover{ transform:translateY(-1px); }
    .mm-gleft{ display:flex; align-items:center; gap:12px; min-width:0; }
    .mm-avatar{ width:48px; height:48px; aspect-ratio:1/1; border-radius:50%; overflow:hidden; background:linear-gradient(#efefef,#dcdcdc); border:1px solid rgba(0,0,0,.06); flex:0 0 48px; }
    .mm-avatar img{ width:100%; height:100%; object-fit:cover; border-radius:50%; display:block; }
    .mm-gtitles{ display:flex; flex-direction:column; min-width:0; gap:3px; }
    .mm-gtitles .gtitle{ font-weight:600; color:var(--ink); font-size:15px; line-height:1.2; }
    .mm-gtitles .gsub{ font-size:13.5px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:420px; }
    .mm-gtitles .gmeta{ font-size:13px; color:var(--muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:420px; }
    .mm-gactions{ display:flex; align-items:center; }
    .mm-btn{ appearance:none !important; border:none !important; border-radius:999px !important; padding:11px 20px !important; font-weight:700 !important; line-height:1 !important; background:var(--accent); color:#fff; opacity:.6; pointer-events:none; cursor:not-allowed; font-size:14px; transition:background .2s ease, transform .2s ease; }
    .mm-gprof.enabled .mm-btn{ cursor:pointer; opacity:1; }
    .mm-btn:hover{ background:#1667cf; }
    .mm-btn:active{ transform:scale(.97); }

    /* Tablet */
    @media (max-width:900px){ .mm-card{ width:min(500px,94%); } }

    /* ===== Mobile-Feinschliff ===== */
    @media (max-width:640px){
      .mm-carousel{ padding:0 34px; }
      .mm-card{ width:96% !important; box-shadow:none !important; border:1px solid rgba(60,64,67,.06); }
      .is-active{ transform:translate(-50%,-50%) scale(1) !important; } /* kein 3D */
      .is-prev,.is-next{ display:none !important; }                      /* keine Nachbarn */
      .mm-arrow.left{ left:12px !important; } .mm-arrow.right{ right:12px !important; }  /* nicht abgeschnitten */

      .mm-gprof{ flex-direction:column; align-items:center; text-align:center; gap:14px; border-radius:24px; padding:18px; }
      .mm-gleft{ width:100%; justify-content:center; }
      .mm-gtitles .gsub,.mm-gtitles .gmeta{ max-width:100%; }
      .mm-gactions{ width:100%; justify-content:center; }
      .mm-btn{ width:100%; max-width:220px; }

      .mm-card.has-more .more-toggle{ display:inline-flex; }
      .mm-card.is-collapsed .quote{
        display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:7;
        overflow:hidden; padding-bottom:4px;
      }
      .mm-card.is-collapsed .quote::after{
        content:""; position:absolute; inset:auto 0 0 0; height:44px;
        background:linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.92) 55%, rgba(255,255,255,1) 100%);
      }
    }

    /* Fallback NUR solange JS noch nicht ready ist */
    #mmTrack[data-mm-ready="0"] > article:first-child{
      position:relative; left:auto; top:auto; transform:none; opacity:1; z-index:1;
    }
  </style>

