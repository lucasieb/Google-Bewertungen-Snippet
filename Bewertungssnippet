    function render(){
      cards=[]; track.innerHTML='';
      reviews.forEach((r,i)=>{ const c=createCard(r,i); cards.push(c); track.appendChild(c); });
    }

    function updateTruncationStates(){
      const mobile=isMobile();
      cards.forEach(card=>{
        const isLong=card.dataset.long==='1';
        const toggle=card.querySelector('.more-toggle');
        const label=toggle ? toggle.querySelector('span') : null;
        if(!isLong){
          card.classList.remove('has-more','is-collapsed','is-expanded');
          if(toggle){ toggle.hidden=true; toggle.setAttribute('aria-expanded','false'); if(label) label.textContent='Mehr anzeigen'; }
          return;
        }
        card.classList.add('has-more');
        if(!toggle) return;
        if(mobile){
          toggle.hidden=false;
          if(!card.classList.contains('is-expanded')){
            card.classList.add('is-collapsed');
            if(label) label.textContent='Mehr anzeigen';
            toggle.setAttribute('aria-expanded','false');
          }else{
            card.classList.remove('is-collapsed');
            if(label) label.textContent='Weniger anzeigen';
            toggle.setAttribute('aria-expanded','true');
          }
        }else{
          toggle.hidden=true;
          card.classList.remove('is-collapsed');
          if(card.classList.contains('is-expanded')){
            card.classList.remove('is-expanded');
          }
          if(label) label.textContent='Mehr anzeigen';
          toggle.setAttribute('aria-expanded','false');
        }
      });
    }

    /* Höhe der längsten Karte messen */
    let maxH = 340;
    function measureMax(){
      const meas = document.createElement('div');
      const w = Math.min(carousel.clientWidth || 600, 500);
      meas.style.cssText = `position:fixed;left:-9999px;top:-9999px;width:${w}px;padding:0;margin:0`;
      document.body.appendChild(meas);
      let h=0;
      cards.forEach(c=>{
        const x=c.cloneNode(true);
        x.className=c.className;
        x.classList.remove('is-prev','is-next','is-hide');
        x.classList.add('is-active');
        x.style.position='static'; x.style.transform='none'; x.style.boxShadow='none';
        meas.appendChild(x); h=Math.max(h, x.offsetHeight); meas.removeChild(x);
      });
      document.body.removeChild(meas);
      maxH = Math.max(280, h);
      carousel.style.height = maxH+'px';
    }

    /* Sichtbare States setzen */
    let idx = 0;
    function apply(){
      const n=cards.length; if(!n) return;
      if(idx>=n){ idx = n-1; }
      if(idx<0){ idx = 0; }
      cards.forEach(c=>{
        c.classList.remove('is-active','is-prev','is-next');
        c.classList.add('is-hide');
      });
      const a = cards[(idx%n+n)%n];
      a.classList.remove('is-hide');
      a.classList.add('is-active');
      if(!isMobile() && n>1){
        const prevIndex=(idx-1+n)%n;
        const nextIndex=(idx+1)%n;
        if(prevIndex!==idx){
          const p = cards[prevIndex];
          p.classList.remove('is-hide');
          p.classList.add('is-prev');
        }
        if(nextIndex!==idx && nextIndex!==((idx-1+n)%n)){
          const nx = cards[nextIndex];
          nx.classList.remove('is-hide');
          nx.classList.add('is-next');
        }
      }
      carousel.style.height = maxH+'px';
    }
    function next(){ if(cards.length<=1) return; idx=(idx+1)%cards.length; apply(); }
    function prev(){ if(cards.length<=1) return; idx=(idx-1+cards.length)%cards.length; apply(); }

    function applyCardData(list,{resetIndex=true}={}){
      if(!Array.isArray(list) || !list.length) return false;
      reviews = list.slice(0, MAX_REVIEWS);
      if(!reviews.length) return false;
      if(resetIndex || idx>=reviews.length){ idx = 0; }
      else if(idx<0){ idx = 0; }
      render();
      updateTruncationStates();
      measureMax();
      apply();
      return true;
    }

    function setReviewsFromRaw(rawList,{resetIndex=true}={}){
      const normalized = dedupeReviews(Array.isArray(rawList)?rawList:[rawList]);
      if(!normalized.length) return false;
      const cardData = normalized.map(reviewRecordToCard).filter(Boolean);
      if(!cardData.length) return false;
      return applyCardData(cardData, {resetIndex});
    }

    /* Swipe */
    function bindSwipe(){
      let startX=null;
      track.addEventListener('touchstart',e=>{ startX=e.touches[0].clientX; },{passive:true});
      track.addEventListener('touchend',e=>{
        if(startX===null) return;
        const dx=e.changedTouches[0].clientX-startX;
        if(Math.abs(dx)>40){ dx<0?next():prev(); }
        startX=null;
      });
    }

    function firstString(value, seen=new Set()){
      if(value===undefined || value===null) return '';
      if(typeof value==='string'){ return value; }
      if(typeof value==='number' || typeof value==='boolean'){ return String(value); }
      if(seen.has(value)) return '';
      if(Array.isArray(value)){
        for(const entry of value){
          const res=firstString(entry, seen);
          if(res) return res;
        }
        return '';
      }
      if(typeof value==='object'){
        seen.add(value);
        const candidates=[
          value.url,
          value.contentUrl,
          value.logo,
          value.image,
          value.photo,
          value.thumbnail,
          value.thumbnailUrl,
          value.src,
          value.href,
          value['@id'],
          value.name,
          value.text,
        ];
        for(const candidate of candidates){
          const res=firstString(candidate, seen);
          if(res){
            seen.delete(value);
            return res;
          }
        }
        seen.delete(value);
      }
      return '';
    }

    function cleanText(value){
      const str=firstString(value);
      return str ? str.replace(/\s+/g,' ').trim() : '';
    }

    function parseJsonLd(doc){
      const info={};
      const scripts=Array.from(doc.querySelectorAll('script[type="application/ld+json"]'));
      const pushData=data=>{
        if(!data || typeof data!=='object') return;
        const types=[data['@type']].flat().filter(Boolean).map(t=>String(t).toLowerCase());
        const isBusiness=types.some(t=>/business|organization|store|service|place/.test(t));
        if(!isBusiness) return;
        const name=cleanText(data.name);
        if(name && !info.name){ info.name=name; }
        const imageCandidate=cleanText(data.image) || cleanText(data.logo) || cleanText(data.photo) || cleanText(data.image?.url);
        if(imageCandidate && !info.image){ info.image=imageCandidate; }
        const description=cleanText(data.description) || cleanText(data.slogan) || cleanText(data.tagline);
        if(description && !info.subtitle){ info.subtitle=description; }
        const address=data.address;
        if(address && !info.locality){
          const addresses=Array.isArray(address)?address:[address];
          for(const entry of addresses){
            if(typeof entry==='string'){
              const txt=cleanText(entry);
              if(txt){ info.locality=txt; break; }
            }else if(entry && typeof entry==='object'){
              const locality=cleanText(entry.addressLocality);
              const region=cleanText(entry.addressRegion);
              const country=cleanText(entry.addressCountry);
              const street=cleanText(entry.streetAddress);
              const parts=[locality,region,country].filter(Boolean);
              if(parts.length){ info.locality=parts.join(', '); break; }
              if(street){ info.locality=street; break; }
            }
          }
        }
        const rating=data.aggregateRating;
        if(rating){
          if(rating.ratingValue && !info.rating){
            const num=Number(rating.ratingValue);
            info.rating=!Number.isNaN(num)?num:rating.ratingValue;
          }
          if(rating.reviewCount && !info.reviewCount){
            const num=Number(rating.reviewCount);
            info.reviewCount=!Number.isNaN(num)?num:rating.reviewCount;
          }
        }
        if(!info.rating && data.ratingValue){
          const num=Number(data.ratingValue);
          info.rating=!Number.isNaN(num)?num:data.ratingValue;
        }
        if(!info.reviewCount && data.reviewCount){
          const num=Number(data.reviewCount);
          info.reviewCount=!Number.isNaN(num)?num:data.reviewCount;
        }
        if(data.servesCuisine && !info.subtitle){ info.subtitle=data.servesCuisine; }
        if(data.category && !info.subtitle){ info.subtitle=data.category; }
        if(data.review){ mergeReviews(info, data.review); }
        if(data.reviews){ mergeReviews(info, data.reviews); }
      };
      scripts.forEach(scr=>{
        try{
          const json=JSON.parse(scr.textContent.trim());
          (Array.isArray(json)?json:[json]).forEach(item=>{
            if(item['@graph']) item['@graph'].forEach(pushData);
            pushData(item);
          });
        }catch(e){/* ignore */}
      });
      return info;
    }

    function absoluteUrl(value, base){
      const str=cleanText(value);
      if(!str) return '';
      try{ return new URL(str, base).href; }
      catch(_){ return str; }
    }

    function extractReviewsFromDom(doc){
      if(!doc) return [];
      const reviews=[];
      const base=doc.baseURI || '';
      const nodes=doc.querySelectorAll('[data-review-id]');
      nodes.forEach(node=>{
        const textSelectors=['[jsname="fbQN7e"]','[jsname="bN97Pc"]','.wiI7pd','.ODSEW-ShBeI-text'];
        let text='';
        for(const sel of textSelectors){
          const el=node.querySelector(sel);
          if(el){ text=cleanText(el.textContent); if(text) break; }
        }
        if(!text) return;
        let rating=null;
        const ratingEl=node.querySelector('[aria-label*="Stern"],[aria-label*="star"],[role="img"][aria-label]');
        if(ratingEl){ rating=pickRatingFromLabel(ratingEl.getAttribute('aria-label') || ratingEl.textContent); }
        if(rating===null){
          const starContainer=node.querySelector('.kvMYJc');
          if(starContainer){
            rating=pickRating(
              starContainer.getAttribute('aria-label'),
              starContainer.getAttribute('aria-valuenow'),
              starContainer.textContent
            );
            if(rating===null){
              const starSpans=starContainer.querySelectorAll('span[style*="width"]');
              if(starSpans.length){
                let total=0;
                starSpans.forEach(span=>{
                  const style=span.getAttribute('style')||'';
                  const match=style.match(/width:\s*([0-9.]+)%/);
                  if(match){ total+=Math.max(0, Math.min(100, parseFloat(match[1])))/100; }
                  else{ total+=1; }
                });
                if(total>0){ rating=Math.max(1, Math.min(5, Math.round(total))); }
              }
            }
          }
        }
        if(rating===null) return;
        const author = cleanText(
          node.querySelector('.d4r55')?.textContent
          || node.querySelector('.ODSEW-ShBeI-title')?.textContent
          || node.querySelector('[role="link"] span')?.textContent
        );
