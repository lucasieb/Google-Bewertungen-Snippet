  </div>

  <script>
  (function(){
    /* Daten */
    const BUTTERBLUME_AVATAR = "data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20160%20160%27%3E%0A%20%20%3Cdefs%3E%0A%20%20%20%20%3CradialGradient%20id%3D%27petal%27%20cx%3D%2780%27%20cy%3D%2780%27%20r%3D%2764%27%20gradientUnits%3D%27userSpaceOnUse%27%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%270%27%20stop-color%3D%27%23ffe697%27/%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%270.55%27%20stop-color%3D%27%23ffc34d%27/%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%271%27%20stop-color%3D%27%23f09a1c%27/%3E%0A%20%20%20%20%3C/radialGradient%3E%0A%20%20%20%20%3CradialGradient%20id%3D%27center%27%20cx%3D%2780%27%20cy%3D%2780%27%20r%3D%2722%27%20gradientUnits%3D%27userSpaceOnUse%27%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%270%27%20stop-color%3D%27%23fff8d0%27/%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%271%27%20stop-color%3D%27%23f7b500%27/%3E%0A%20%20%20%20%3C/radialGradient%3E%0A%20%20%20%20%3ClinearGradient%20id%3D%27stem%27%20x1%3D%2780%27%20y1%3D%2796%27%20x2%3D%2780%27%20y2%3D%27150%27%20gradientUnits%3D%27userSpaceOnUse%27%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%270%27%20stop-color%3D%27%235fb264%27/%3E%0A%20%20%20%20%20%20%3Cstop%20offset%3D%271%27%20stop-color%3D%27%232f7d32%27/%3E%0A%20%20%20%20%3C/linearGradient%3E%0A%20%20%3C/defs%3E%0A%20%20%3Crect%20x%3D%276%27%20y%3D%276%27%20width%3D%27148%27%20height%3D%27148%27%20rx%3D%2732%27%20fill%3D%27%23fffdf5%27%20stroke%3D%27%23f7b500%27%20stroke-width%3D%274%27/%3E%0A%20%20%3Cg%20fill%3D%27url%28%23petal%29%27%20stroke%3D%27%23f18c1c%27%20stroke-width%3D%274%27%20stroke-linejoin%3D%27round%27%3E%0A%20%20%20%20%3Cellipse%20cx%3D%2780%27%20cy%3D%2734%27%20rx%3D%2720%27%20ry%3D%2728%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%2780%27%20cy%3D%27126%27%20rx%3D%2720%27%20ry%3D%2728%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%2734%27%20cy%3D%2780%27%20rx%3D%2728%27%20ry%3D%2720%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%27126%27%20cy%3D%2780%27%20rx%3D%2728%27%20ry%3D%2720%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%2752%27%20cy%3D%2752%27%20rx%3D%2720%27%20ry%3D%2728%27%20transform%3D%27rotate%28-45%2052%2052%29%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%27108%27%20cy%3D%27108%27%20rx%3D%2720%27%20ry%3D%2728%27%20transform%3D%27rotate%28-45%20108%20108%29%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%27108%27%20cy%3D%2752%27%20rx%3D%2720%27%20ry%3D%2728%27%20transform%3D%27rotate%2845%20108%2052%29%27/%3E%0A%20%20%20%20%3Cellipse%20cx%3D%2752%27%20cy%3D%27108%27%20rx%3D%2720%27%20ry%3D%2728%27%20transform%3D%27rotate%2845%2052%20108%29%27/%3E%0A%20%20%3C/g%3E%0A%20%20%3Ccircle%20cx%3D%2780%27%20cy%3D%2780%27%20r%3D%2722%27%20fill%3D%27url%28%23center%29%27%20stroke%3D%27%23f18c1c%27%20stroke-width%3D%274%27/%3E%0A%20%20%3Cpath%20d%3D%27M80%20102c-10%2012-8%2032-24%2040%2018-2%2026-10%2028-20%202%2010%2010%2018%2028%2020-16-8-14-28-24-40z%27%20fill%3D%27url%28%23stem%29%27%20stroke%3D%27%232f7d32%27%20stroke-width%3D%274%27%20stroke-linecap%3D%27round%27/%3E%0A%3C/svg%3E";

    const GOOGLE_PROFILE = {
      url: "https://share.google/VIHwvNVoxddZ96EHF",
      fallback: {
        name: "Butterblume Blumen & Geschenke",
        subtitle: "Florist · Blumen & Geschenkideen",
        locality: "Florist in Deutschland",
        rating: "4,9",
        reviewCount: 87,
        image: BUTTERBLUME_AVATAR
      }
    };

    const FALLBACK_REVIEWS = [
      { stars:5, quote:"Ich habe einen frischen Wiesenstrauß bestellt und war begeistert: liebevoll gebunden, wunderschön abgestimmt und pünktlich fertig. Der Laden ist mit so viel Herz dabei!", name:"Claudia H.", tag:"Google-Rezension" },
      { stars:5, quote:"Sehr freundliche Beratung und tolle Geschenkideen. Selbst kurzfristige Wünsche werden umgesetzt und der Strauß hält überdurchschnittlich lange.", name:"Marius K.", tag:"Google-Rezension" },
      { stars:5, quote:"Butterblume hat unsere Hochzeit floristisch begleitet. Dekoration, Brautstrauß und Tischschmuck waren traumhaft und perfekt aufeinander abgestimmt.", name:"Svenja & Jonas", tag:"Google-Rezension" },
      { stars:5, quote:"Ich lasse regelmäßig Blumen liefern und jedes Mal ist die Gestaltung kreativ und hochwertig. Preis-Leistung top und immer zuverlässig.", name:"Sabine L.", tag:"Google-Rezension" },
      { stars:5, quote:"Wunderschöner Laden mit viel Liebe zum Detail. Besonders gefällt mir, dass auf Nachhaltigkeit geachtet wird – saisonale Blumen und faire Verpackungen.", name:"Daniela R.", tag:"Google-Rezension" },
      { stars:5, quote:"Für eine Trauerfeier wurde alles sehr einfühlsam organisiert. Die Gestecke sahen würdevoll aus und wurden exakt zum Termin geliefert.", name:"Thomas B.", tag:"Google-Rezension" },
      { stars:5, quote:"Tolle Auswahl an Pflanzen und dekorativen Geschenkideen. Man merkt sofort, dass das Team Ahnung hat und mit viel Leidenschaft berät.", name:"Marie T.", tag:"Google-Rezension" },
      { stars:5, quote:"Ich habe einen Workshop besucht und bin begeistert, wie viel Wissen und Inspiration vermittelt wurde. Absolut empfehlenswert!", name:"Lena P.", tag:"Google-Rezension" }
    ];

    const MAX_REVIEWS = 24;

    let reviews = FALLBACK_REVIEWS.slice();

    const LONG_QUOTE_THRESHOLD = 260;

    /* Elemente */
    const root = document.getElementById('mm-reviews');
    const track = root.querySelector('#mmTrack');
    const prevBtn = root.querySelector('#mmPrev');
    const nextBtn = root.querySelector('#mmNext');
    const carousel = root.querySelector('.mm-carousel');

    const isMobile = ()=> matchMedia('(max-width:640px)').matches;
    const starRow = n => "★".repeat(n) + "☆".repeat(5-n);

    function formatDateLabel(value){
      const text=cleanText(value);
      if(!text) return '';
      const digits=text.replace(/[^0-9]/g,'');
      let date=null;
      if(/^[0-9]{13}$/.test(digits)){ date=new Date(Number(digits)); }
      else if(/^[0-9]{10}$/.test(digits)){ date=new Date(Number(digits)*1000); }
      else if(/^[0-9]{4}-[0-9]{2}-[0-9]{2}/.test(text)){ date=new Date(text); }
      else {
        const dotMatch=text.match(/^(\d{1,2})\.(\d{1,2})\.(\d{2,4})$/);
        if(dotMatch){
          let year=Number(dotMatch[3]);
          if(dotMatch[3].length===2){ year += year>=70 ? 1900 : 2000; }
          const month=Number(dotMatch[2])-1;
          const day=Number(dotMatch[1]);
          const candidate=new Date(year, month, day);
          if(!Number.isNaN(candidate.getTime())){ date=candidate; }
        }
      }
      if(date && !Number.isNaN(date.getTime())){
        return date.toLocaleDateString('de-DE',{ day:'2-digit', month:'long', year:'numeric' });
      }
      return text;
    }

    function pickRating(...candidates){
      for(const candidate of candidates){
        if(candidate===undefined || candidate===null) continue;
        if(typeof candidate==='number' && Number.isFinite(candidate)){
          let num=candidate;
          if(num>5 && num<=50){ num=num/10; }
          if(num>0 && num<=5){ return num; }
          continue;
        }
        if(typeof candidate==='string'){
          const trimmed=candidate.trim();
          if(!trimmed) continue;
          if(/vor\s+\d+/i.test(trimmed)) continue;
          const match=trimmed.match(/([0-9]+(?:[\.,][0-9]+)?)/);
          if(!match) continue;
          let num=Number(match[1].replace(',','.'));
          if(!Number.isFinite(num)) continue;
          if(num>5 && num<=50){ num=num/10; }
          if(num>0 && num<=5){ return num; }
          continue;
        }
        if(typeof candidate==='object'){
          if(candidate && candidate.ratingValue!==undefined){
            const val=pickRating(candidate.ratingValue);
            if(val!==null) return val;
          }
          if(candidate && candidate.value!==undefined){
            const val=pickRating(candidate.value);
            if(val!==null) return val;
          }
        }
      }
      return null;
    }

    const reviewKey = review => `${review && review.id ? review.id : ''}|${review && review.author ? review.author : ''}|${review && review.text ? review.text : ''}`;

    function pickRatingFromLabel(label){
      return pickRating(label);
    }

    function normalizeReviewRecord(review){
      if(!review || typeof review!=='object') return null;
      if(Array.isArray(review)) return null;
      const rating = pickRating(
        review.rating,
        review.ratingValue,
        review.stars,
        review.starRating,
        review.score,
        review.value,
        review.reviewRating && review.reviewRating.ratingValue
      );
      if(rating===null) return null;
      const text = cleanText(review.text || review.reviewBody || review.body || review.comment || review.quote || review.snippet || review.message || review.content || review.description);
      if(!text) return null;
      const author = cleanText(
        review.author && (review.author.name || review.author.fullName || review.author.displayName)
        || review.reviewer && (review.reviewer.name || review.reviewer.displayName)
        || review.profileName
        || review.byline
        || review.user
        || review.username
        || review.title
        || review.author
      );
      const date = cleanText(
        review.date || review.datePublished || review.publishDate || review.published || review.updated || review.relativeTimeDescription || review.relativePublishTimeDescription || review.relativeTime || review.time || review.reviewDate
      );
      const url = cleanText(review.url || review.link || review.authorUrl || review.profileUrl);
      const id = cleanText(review.id || review.reviewId || review.cid || review.fid || review.token || review.name || review.googleReviewId || review.reviewToken);
      return {
        id: id || '',
        author: author || '',
        rating,
        text,
        date: date || '',
        url: url || ''
      };
    }

    function dedupeReviews(records){
      if(!Array.isArray(records)) return [];
      const seen=new Set();
      const out=[];
      records.forEach(entry=>{
        const normalized=normalizeReviewRecord(entry);
        if(!normalized) return;
        const key=reviewKey(normalized);
        if(seen.has(key)) return;
        seen.add(key);
        out.push(normalized);
      });
      return out;
    }

    function mergeReviews(info, entries){
      if(!entries) return;
      const list=Array.isArray(entries) ? entries : [entries];
      const incoming=dedupeReviews(list);
      if(!incoming.length) return;
      if(!Array.isArray(info.reviews) || !info.reviews.length){
        info.reviews=incoming.slice();
        return;
      }
      const existing=new Set(info.reviews.map(reviewKey));
      incoming.forEach(item=>{
        const key=reviewKey(item);
        if(existing.has(key)) return;
        existing.add(key);
        info.reviews.push(item);
      });
    }

    function reviewRecordToCard(record){
      if(!record) return null;
      const starsValue=pickRating(record.rating);
      if(starsValue===null) return null;
      const stars=Math.max(1, Math.min(5, Math.round(starsValue)));
      const quote=cleanText(record.text);
      if(!quote) return null;
      const name=cleanText(record.author) || 'Google-Nutzer';
