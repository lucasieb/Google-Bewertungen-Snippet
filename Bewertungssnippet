    function normalizeNumber(value){
      if(value===undefined || value===null || value==='') return null;
      if(typeof value==='number' && Number.isFinite(value)) return value;
      if(typeof value==='string'){
        const normalized=value.replace(/[^0-9,\.]/g,'').replace(',','.');
        if(!normalized) return null;
        const num=Number(normalized);
        return Number.isFinite(num) ? num : null;
      }
      return null;
    }

    function normalizeCount(value){
      const num=normalizeNumber(value);
      if(num===null) return null;
      return Math.round(num);
    }

    function pickImageUrl(candidate){
      if(!candidate) return '';
      if(typeof candidate==='string'){
        const trimmed=candidate.trim();
        if(!trimmed) return '';
        if(/^data:/i.test(trimmed)) return '';
        if(/maps\.gstatic\.com/i.test(trimmed)) return '';
        if(trimmed.startsWith('//')) return trimmed;
        if(/^https?:\/\//i.test(trimmed)) return trimmed;
        return '';
      }
      if(Array.isArray(candidate)){
        for(const item of candidate){
          const url=pickImageUrl(item);
          if(url) return url;
        }
      }else if(typeof candidate==='object'){
        const keys=['url','image','src','href','photoUri','thumbnailUrl','coverPhoto','icon','value'];
        for(const key of keys){
          if(key in candidate){
            const url=pickImageUrl(candidate[key]);
            if(url) return url;
          }
        }
      }
      return '';
    }

    function extractAddress(value){
      if(!value) return '';
      if(typeof value==='string'){ return cleanText(value); }
      const parts=[];
      const pushPart=part=>{
        const text=extractAddress(part);
        if(text){ parts.push(text); }
      };
      if(Array.isArray(value)){
        value.forEach(pushPart);
      }else if(typeof value==='object'){
        const keys=['addressLines','addressLine','line','streetAddress','postalCode','addressLocality','locality','city','administrativeArea','region','state','province','country','countryCode','subLocality','area','county'];
        for(const key of keys){
          if(value[key]) pushPart(value[key]);
        }
      }
      return parts.map(cleanText).filter(Boolean).filter((v,i,arr)=>arr.indexOf(v)===i).join(', ');
    }

    function applyInfo(target, source){
      if(!source) return target;
      const out={...target};
      ['name','subtitle','locality','image','rating','reviewCount'].forEach(key=>{
        if(out[key]===undefined || out[key]===null || out[key]===''){
          const value=source[key];
          if(value!==undefined && value!==null && value!==''){
            out[key]=value;
          }
        }
      });
      if(Array.isArray(source.reviews) && source.reviews.length){
        if(!Array.isArray(out.reviews) || !out.reviews.length){
          out.reviews=dedupeReviews(source.reviews);
        }else{
          mergeReviews(out, source.reviews);
        }
      }
      return out;
    }

    function scanGoogleData(value, info){
      if(value===undefined || value===null) return;
      if(Array.isArray(value)){
        mergeReviews(info, value);
        if(value.length>=2){
          const first=value[0];
          const second=value[1];
          if(typeof first==='string'){ const text=cleanText(first); if(text && text.length<=140 && !info.name) info.name=text; }
          if(typeof second==='string'){ const text=cleanText(second); if(text && text.length<=200 && !info.subtitle) info.subtitle=text; }
        }
        value.forEach(item=>scanGoogleData(item, info));
        return;
      }
      if(typeof value==='object'){
        if(typeof value.name==='string' && value.name.trim() && !info.name){ info.name=value.name.trim(); }
        if(typeof value.title==='string' && value.title.trim() && !info.name){ info.name=value.title.trim(); }
        const subtitleCandidate=value.description || value.subtitle || value.tagline || value.category || value.primaryText || value.primaryCategory || value.headline;
        if(typeof subtitleCandidate==='string' && subtitleCandidate.trim() && !info.subtitle){ info.subtitle=subtitleCandidate.trim(); }
        if(value.displayName && typeof value.displayName.text==='string' && value.displayName.text.trim() && !info.name){ info.name=value.displayName.text.trim(); }
        if(value.businessInfo && typeof value.businessInfo==='object'){
          scanGoogleData(value.businessInfo, info);
        }
        if(value.profileInfo && typeof value.profileInfo==='object'){
          scanGoogleData(value.profileInfo, info);
        }
        if(value.locationInfo && typeof value.locationInfo==='object'){
          scanGoogleData(value.locationInfo, info);
        }
        const addressCandidate=value.address || value.addressInfo || value.location || value.businessAddress;
        if(!info.locality){
          const extracted=extractAddress(addressCandidate);
          if(extracted) info.locality=extracted;
        }
        const imageCandidate=value.image || value.logo || value.photo || value.coverPhoto || value.icon || value.heroImage || value.photos || value.profileImage || value.photoUri || value.thumbnailUrl;
        if(!info.image){
          const url=pickImageUrl(imageCandidate);
          if(url) info.image=url;
        }
        const ratingKeys=['rating','overallRating','averageRating','starRating','aggregateRating','ratingValue'];
        for(const key of ratingKeys){
          if(info.rating) break;
          if(!(key in value)) continue;
          const val=value[key];
          if(typeof val==='object'){ scanGoogleData(val, info); }
          const num=normalizeNumber(val);
          if(num!==null && num>0 && num<=5){ info.rating=num; break; }
        }
        const countKeys=['userRatingCount','reviewCount','reviewsCount','ratingCount','reviewNumber'];
        for(const key of countKeys){
          if(info.reviewCount) break;
          if(!(key in value)) continue;
          const num=normalizeCount(value[key]);
          if(num){ info.reviewCount=num; break; }
        }
        const reviewCandidates=[
          value.review,
          value.reviews,
          value.topReviews,
          value.reviewList,
          value.recentReviews,
          value.highlights,
          value.testimonials
        ];
        reviewCandidates.forEach(entry=>{ if(entry) mergeReviews(info, entry); });
        Object.values(value).forEach(v=>scanGoogleData(v, info));
        return;
      }
      if(typeof value==='string'){
        const text=value.trim();
        if(!text) return;
        if(!info.image && /https?:\/\/.+googleusercontent\.com\//i.test(text)){ info.image=text; }
        if(!info.subtitle && text.length>20 && text.length<240 && /[·•,]/.test(text)){ info.subtitle=cleanText(text); }
        return;
      }
      if(typeof value==='number'){
        if(!info.rating && value>0 && value<=5){ info.rating=value; return; }
        if(!info.reviewCount && value>0 && Number.isInteger(value) && value<200000){ info.reviewCount=value; }
      }
    }

    function extractGoogleProfileFromHtml(html){
      if(!html) return {};
      const info={};
      const appMatch=html.match(/APP_INITIALIZATION_STATE=(\[[\s\S]*?\]);/);
      if(appMatch){
        try{
          const parsed=JSON.parse(appMatch[1]);
          scanGoogleData(parsed, info);
        }catch(_){ /* ignore */ }
      }
      const callbackRegex=/AF_initDataCallback\(([^)]*)\);/g;
      let cbMatch;
      while((cbMatch=callbackRegex.exec(html))){
        const chunk=cbMatch[1];
        const dataIdx=chunk.indexOf('data:');
        if(dataIdx===-1) continue;
        const start=chunk.indexOf('[', dataIdx);
        if(start===-1) continue;
        let depth=0; let inString=false; let escape=false; let end=-1;
        for(let i=start;i<chunk.length;i++){
          const ch=chunk[i];
          if(inString){
            if(escape){ escape=false; continue; }
            if(ch==='\\'){ escape=true; continue; }
            if(ch==='"'){ inString=false; }
            continue;
          }
          if(ch==='"'){ inString=true; continue; }
          if(ch==='['){ depth++; }
          if(ch===']'){
            depth--;
            if(depth===0){ end=i; break; }
          }
        }
        if(end===-1) continue;
        const jsonText=chunk.slice(start, end+1);
        try{
          const parsed=JSON.parse(jsonText);
          scanGoogleData(parsed, info);
        }catch(_){ /* ignore */ }
      }
      return info;
    }

    function enrichProfileInfo(base, html){
      const googleInfo=extractGoogleProfileFromHtml(html);
      const merged=applyInfo(base||{}, googleInfo);
      if(merged.name && merged.subtitle){
        const nameClean=cleanText(merged.name).toLowerCase();
        const subClean=cleanText(merged.subtitle).toLowerCase();
        if(nameClean && subClean && nameClean===subClean){
          merged.subtitle='';
        }
      }
      return merged;
    }

    async function resolveProfile(url){
      if(!url) return {};
      const attempts=[];
      const cleaned=url.trim();
      if(cleaned) attempts.push(cleaned);
      if(/^https?:\/\//i.test(cleaned) && !/^https?:\/\/r\.jina\.ai\//i.test(cleaned)){
        const proxied=`https://r.jina.ai/${cleaned}`;
        if(!attempts.includes(proxied)) attempts.push(proxied);
      }
      let bestInfo=null;
      let bestScore=-1;
      let lastError=null;
      for(const target of attempts){
        try{
          const res=await fetch(target,{mode:'cors'});
          if(!res.ok) throw new Error(`Request failed (${res.status})`);
          const text=await res.text();
          const doc=new DOMParser().parseFromString(text,'text/html');
          const info=enrichProfileInfo(extractProfileFromDocument(doc) || {}, text);
          if(Array.isArray(info.reviews) && info.reviews.length){
            info.reviews=dedupeReviews(info.reviews).slice(0, MAX_REVIEWS);
            if(!info.reviewCount){ info.reviewCount=info.reviews.length; }
          }
          const resolvedUrl=(res.url && res.url.startsWith('https://r.jina.ai/')) ? cleaned : (res.url||cleaned);
          const hasData=Object.keys(info).length>0;
          info._baseUrl=resolvedUrl;
          const coreKeys=['name','subtitle','locality','image'];
          const score=coreKeys.reduce((acc,key)=> acc + (info[key]?1:0), 0);
          if(hasData && (score>=3 || target.startsWith('https://r.jina.ai/'))){
            return info;
          }
          if(score>bestScore){ bestInfo=info; bestScore=score; }
        }catch(err){
          lastError=err;
        }
      }
      if(lastError){ console.warn('[mm-reviews] Profil konnte nicht vollständig geladen werden', lastError); }
      return bestInfo || {};
    }

    function formatNumber(value){
      if(value===undefined||value===null||value==='') return '';
      if(typeof value==='number'){ return value.toLocaleString('de-DE'); }
      return value;
    }

    /* Google-Zeile */
    (function initG(){
      const row=root.querySelector('#mmGProf');
      const btn=root.querySelector('#mmGBtn');
      const nameEl=root.querySelector('#mmGName');
      const subEl=root.querySelector('#mmGSub');
      const metaEl=root.querySelector('#mmGMeta');
      const imgEl=root.querySelector('#mmGImg');
      const fallback={...(GOOGLE_PROFILE.fallback||{})};
      const profileUrl=GOOGLE_PROFILE.url;

      const apply=data=>{
        const merged=applyInfo(data ? {...data} : {}, fallback);
        const imageBase=(data && data._baseUrl) || profileUrl;
        const canOpen=profileUrl && /^https?:\/\//i.test(profileUrl);
        const reviewList=Array.isArray(data && data.reviews) && data.reviews.length ? data.reviews : merged.reviews;
        if(!merged.reviewCount && Array.isArray(reviewList) && reviewList.length){
          merged.reviewCount=reviewList.length;
        }
        const ratingVal=merged.rating;
        const reviewCount=merged.reviewCount;
        const displayName=cleanText(merged.name) || 'Unternehmensprofil';
        const subtitle=cleanText(merged.subtitle) || 'Kurzbeschreibung / Kategorie';
        const locality=cleanText(merged.locality);
        btn.textContent='Jetzt auf Google bewerten';
        btn.setAttribute('aria-label','Jetzt auf Google bewerten');
        btn.setAttribute('title','Jetzt auf Google bewerten');
        nameEl.textContent=displayName;
        subEl.textContent=subtitle;
        const imageSource=absoluteUrl(fallback.image || merged.image || merged.logo || merged.photo, imageBase);
        if(imageSource){
          imgEl.src=imageSource;
          imgEl.style.display='block';
          imgEl.alt=displayName||'Profilbild';
        }else{
          imgEl.removeAttribute('src');
          imgEl.style.display='none';
        }
        const tooltipParts=[];
        if(displayName) tooltipParts.push(displayName);
        if(locality) tooltipParts.push(locality);
        const ratingNumeric=pickRating(ratingVal);
        const ratingDisplay=ratingNumeric!==null
          ? ratingNumeric.toLocaleString('de-DE',{minimumFractionDigits:1, maximumFractionDigits:1})
          : cleanText(ratingVal);
        const reviewDisplay=typeof reviewCount==='number'
          ? formatNumber(reviewCount)
          : cleanText(reviewCount);
        let ratingSentence='';
        if(ratingDisplay && reviewDisplay){
          ratingSentence=`⭐️ ${ratingDisplay} · ${reviewDisplay} Google-Bewertungen`;
        }else if(ratingDisplay){
          ratingSentence=`⭐️ ${ratingDisplay} · Google-Bewertungen`;
        }else if(reviewDisplay){
          ratingSentence=`${reviewDisplay} Google-Bewertungen`;
        }
        const metaParts=[];
        if(locality) metaParts.push(locality);
        if(ratingSentence) metaParts.push(ratingSentence);
        if(metaParts.length){
          metaEl.textContent=metaParts.join(' · ');
          metaEl.hidden=false;
        }else{
          metaEl.textContent='';
          metaEl.hidden=true;
        }
        if(ratingSentence){
          tooltipParts.push(ratingSentence);
        }
        row.setAttribute('title', tooltipParts.filter(Boolean).join(' · '));
        const ariaLabel=[
          displayName||'Google Unternehmensprofil',
          locality || null,
          ratingSentence || null,
          canOpen ? 'Jetzt auf Google bewerten' : 'Profilinformation'
        ].filter(Boolean).join(', ');
        row.setAttribute('aria-label', ariaLabel);
        row.setAttribute('aria-disabled', canOpen ? 'false' : 'true');
        row.setAttribute('tabindex', canOpen ? '0' : '-1');
        btn.setAttribute('aria-disabled', canOpen ? 'false' : 'true');
        btn.setAttribute('tabindex', canOpen ? '0' : '-1');
        return merged;
      };

      apply({});

      if(profileUrl && /^https?:\/\//i.test(profileUrl)){
        row.classList.add('enabled');
        btn.style.opacity='1';
        btn.style.pointerEvents='auto';
        btn.setAttribute('aria-disabled','false');
        const open=()=>window.open(profileUrl,'_blank','noopener');
        row.addEventListener('click',open);
        row.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); open(); }});
        btn.addEventListener('click',e=>{ e.stopPropagation(); open(); });

        if(window.fetch && window.DOMParser){
          resolveProfile(profileUrl).then(data=>{
            if(data && Object.keys(data).length){
              const merged=apply(data);
              let replaced=false;
              if(data.reviews){ replaced=setReviewsFromRaw(data.reviews,{resetIndex:true}); }
              if(!replaced && merged && merged.reviews){
                setReviewsFromRaw(merged.reviews,{resetIndex:true});
              }
            }
          });
        }
      }
    })();

    /* Boot */
    function boot(){
      render();
      updateTruncationStates();
      measureMax();
      idx = Math.floor(Math.random()*cards.length);
      apply();
      prevBtn.addEventListener('click',prev);
      nextBtn.addEventListener('click',next);
      bindSwipe();
      window.addEventListener('resize', ()=>{ updateTruncationStates(); measureMax(); apply(); });
      // Fallback-Flag entfernen => verhindert die "oben links"-Fehlposition
      track.setAttribute('data-mm-ready','1');
    }
    if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', boot); }
    else { boot(); }
  })();
  </script>
