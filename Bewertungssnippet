          node.querySelector('.rsqaWe')?.textContent
          || node.querySelector('.ODSEW-ShBeI-RgZmSc-date')?.textContent
          || node.querySelector('.PuaHbe')?.textContent
        );
        const profileLink=node.querySelector('a[href*="/maps/contrib/"]');
        const url=profileLink ? absoluteUrl(profileLink.getAttribute('href'), base) : '';
        const review={
          id: cleanText(node.getAttribute('data-review-id')),
          author,
          rating,
          text,
          date,
          url
        };
        const normalized=normalizeReviewRecord(review);
        if(normalized){ reviews.push(normalized); }
      });
      return reviews;
    }

    function extractProfileFromDocument(doc){
      const info=parseJsonLd(doc);
      const pick=(sel,attr='content')=>{
        const el=doc.querySelector(sel);
        if(!el) return '';
        return attr==='text'? (el.textContent||'').trim(): (el.getAttribute(attr)||'').trim();
      };
      if(!info.name){
        info.name=cleanText(pick('meta[property="og:title"],meta[name="og:title"],meta[itemprop="name"],meta[name="twitter:title"]')) || cleanText(pick('title','text'));
      }
      if(!info.image){
        info.image=cleanText(pick('meta[property="og:image:secure_url"],meta[property="og:image"],meta[name="og:image"],meta[name="twitter:image"],meta[name="twitter:image:src"],meta[itemprop="image"]'))
          || cleanText(pick('link[rel="image_src"]','href'))
          || cleanText(pick('link[rel*="icon"]','href'));
      }
      if(!info.subtitle){
        info.subtitle=cleanText(pick('meta[property="og:description"],meta[name="og:description"],meta[name="description"],meta[name="twitter:description"],meta[itemprop="description"]'));
      }
      if(!info.locality){
        info.locality=cleanText(pick('[itemprop="addressLocality"]','content') || pick('[itemprop="addressLocality"]','text'))
